{
	"schemaVersion": 1,
	"id": "chatlanes",
	"version": "${version}",
	"name": "ChatLanes",
	"description": "Teilt den Chat in anpassbare Tabs auf: System, Kanäle (z. B. [G] Global), eigene Tabs für private Nachrichten, Server-Profile, Suche und mehr.",
	"authors": [
		"0eiki0"
	],
	"license": "MIT",
	"icon": "assets/chatlanes/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.chatlanes.ChatLanesClient"
		],
		"modmenu": [
			"de.chatlanes.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "chatlanes.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"contact": {
		"sources": "https://github.com/0eiki0/chattabs",
		"issues": "https://github.com/0eiki0/chattabs/issues"
	},
	"suggests": {
		"modmenu": "*"
	},
	"breaks": {
		"chattabs": "*"
	}
}
